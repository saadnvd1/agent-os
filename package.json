{
  "name": "@saadnvd1/agent-os",
  "version": "0.3.1",
  "description": "Self-hosted web UI for managing Claude Code sessions",
  "bin": {
    "agent-os": "scripts/agent-os"
  },
  "files": [
    "app/",
    "components/",
    "contexts/",
    "data/",
    "hooks/",
    "lib/",
    "!lib/security/test-pki.ts",
    "!lib/**/*.test.ts",
    "mcp/",
    "public/",
    "scripts/",
    "stores/",
    "styles/",
    "next.config.ts",
    "server.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "predev": "node scripts/check-native.mjs --rebuild && node scripts/gen-migrations-index.mjs",
    "dev": "AGENTOS_DEV=1 tsx server.ts",
    "dev:task": "tsx scripts/dev-task.ts",
    "dev:stop": "tsx scripts/dev-stop.ts",
    "disk:dry-run": "tsx scripts/disk-dry-run.ts",
    "prebuild": "node scripts/gen-migrations-index.mjs",
    "build": "next build",
    "prestart": "node scripts/check-native.mjs --rebuild && node scripts/gen-migrations-index.mjs",
    "start": "NODE_ENV=production AGENTOS_SERVER=live node --import tsx server.ts",
    "pretypecheck": "node scripts/gen-migrations-index.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "prepare": "husky",
    "prelint": "node scripts/gen-migrations-index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "scripts/test",
    "test:watch": "vitest",
    "check": "scripts/check",
    "screenshots": "tsx scripts/screenshots/run.ts",
    "demo": "tsx scripts/screenshots/demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadnvd1/agent-os.git"
  },
  "keywords": [
    "claude",
    "ai",
    "terminal",
    "tmux",
    "agent"
  ],
  "author": "Saad Naveed",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/saadnvd1/agent-os/issues"
  },
  "homepage": "https://github.com/saadnvd1/agent-os#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@serwist/turbopack": "^9.5.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-strike": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-codemirror": "^4.25.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.556.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "mermaid": "^11.17.2",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "node-pty": "^1.2.0-beta.6",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.3.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "valtio": "^2.3.0",
    "ws": "^8.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.27",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
