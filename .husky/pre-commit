# Format and lint what is staged, then typecheck and run the tests.
# Formatting and lint fixes REWRITE the staged files and re-add them; the rest
# only reports. Skip with `git commit --no-verify` for a work-in-progress.
set -e

# Git hooks don't load the shell profile, so they get whatever node is first
# on PATH; native modules only load under the version they were built for.
# Use the repo's .nvmrc when nvm is installed.
for nvm_sh in "${NVM_DIR:-$HOME/.nvm}/nvm.sh" /opt/homebrew/opt/nvm/nvm.sh; do
  if [ -s "$nvm_sh" ]; then
    . "$nvm_sh" >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1 || true
    break
  fi
done
echo "▸ node $(node -v)"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
FORMAT=$(echo "$STAGED" | grep -E '\.(js|jsx|mjs|ts|tsx|json|css|md)$' | grep -v '^package-lock.json$' || true)
LINT=$(echo "$STAGED" | grep -E '\.(js|jsx|mjs|ts|tsx)$' || true)

# ESLint first: its fixes (e.g. dropping an unused directive) can leave
# whitespace that only Prettier, run after, puts right.
if [ -n "$LINT" ]; then
  echo "▸ eslint"
  echo "$LINT" | xargs npx eslint --fix --no-warn-ignored
fi
if [ -n "$FORMAT" ]; then
  echo "▸ prettier"
  echo "$FORMAT" | xargs npx prettier --write --log-level warn
fi
[ -n "$FORMAT$LINT" ] && echo "$FORMAT
$LINT" | grep . | sort -u | xargs git add

echo "▸ typecheck"
npm run typecheck --silent
echo "▸ tests"
npx vitest run --silent
echo "✓ pre-commit passed"
