# Fast checks on what is staged, so a commit doesn't fail CI for something
# avoidable: formatting, a token-shaped string the merge gate refuses, and
# names that must never land in this public repo.
# Typecheck, lint and tests are CI's (scripts/check); too slow for here.
# Skip in an emergency with `git commit --no-verify`.
set -e

# Git hooks don't load the shell profile, so they get whatever node is first
# on PATH; native modules only load under the version they were built for.
# Use the repo's .nvmrc when nvm is installed.
for nvm_sh in "${NVM_DIR:-$HOME/.nvm}/nvm.sh" /opt/homebrew/opt/nvm/nvm.sh; do
  if [ -s "$nvm_sh" ]; then
    . "$nvm_sh" >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1 || true
    break
  fi
done
bin="$(git rev-parse --show-toplevel)/node_modules/.bin"
[ -x "$bin/prettier" ] || { echo "✗ no node_modules; run npm install" >&2; exit 1; }

# Prettier skips what it can't parse and what .prettierignore lists.
STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED" ]; then
  if ! echo "$STAGED" | tr '\n' '\0' | xargs -0 "$bin/prettier" --check --ignore-unknown --log-level warn; then
    UNFORMATTED=$(echo "$STAGED" | tr '\n' '\0' | xargs -0 "$bin/prettier" --list-different --ignore-unknown 2>/dev/null | sed "s/'/'\\\\''/g; s/.*/'&'/" | paste -sd ' ' -)
    echo "✗ not formatted; fix with:" >&2
    echo "  npx prettier --write $UNFORMATTED && git add $UNFORMATTED" >&2
    exit 1
  fi
fi

"$bin/tsx" scripts/hooks/staged-secrets.ts

# A generic term and a private denylist kept outside the repo
# (~/.config/agent-os/banned-names, one regex per line; the list itself
# would be a mention).
"$bin/tsx" scripts/hooks/banned-terms.ts
