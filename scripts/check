#!/usr/bin/env bash
# The full guard, the same run locally and in CI:
#   scripts/check            banned terms, typecheck, lint, format, tests
#   scripts/check --build    ...and a production build, held to its JS budget
#   scripts/check --changed  what a task runs before its PR: typecheck, plus lint
#                            and format on the files changed since main, plus
#                            only the tests related to them. The full suite runs
#                            when shared infrastructure changed (package.json,
#                            lib/db, vitest config...) or with --full.
# Outside CI it holds one `aos heavy` slot, so checks on a machine take turns.
# CI runs the same groups as parallel jobs:
#   --only static,test,build   run just these groups (static = migrations,
#                              terms, typecheck, lint, format)
#   --parallel                 run typecheck, lint and format at once
#   -- <args>                  passed to `vitest run` (e.g. --shard=1/3)
set -euo pipefail
cd "$(dirname "$0")/.."

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

orig=("$@")
groups="static,test" parallel=0 changed=0 full=0 vitest_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --build) groups="$groups,build" ;;
    --only) [ $# -ge 2 ] || usage; groups="$2"; shift ;;
    --parallel) parallel=1 ;;
    --changed) changed=1 ;;
    --full) full=1 ;;
    --) shift; vitest_args=("$@"); break ;;
    *) usage ;;
  esac
  shift
done
for g in ${groups//,/ }; do
  case "$g" in static|test|build) ;; *) usage ;; esac
done
if [ -z "${CI:-}" ] && [ -z "${AOS_HEAVY_HELD:-}" ] && command -v aos >/dev/null 2>&1; then
  exec aos heavy -- "$0" ${orig[@]+"${orig[@]}"}
fi
has() { [[ ",$groups," == *",$1,"* ]]; }

step() { printf '\n▸ %s\n' "$1"; }

# Node's default heap is too small for this repo's type check on some machines.
tsc() { node --max-old-space-size=4096 node_modules/typescript/lib/tsc.js --noEmit; }

if [ "$changed" = 1 ]; then
  scope=$(npx tsx scripts/check-scope.ts $([ "$full" = 1 ] && echo --full))
  field() { node -e 'const s=JSON.parse(process.argv[1]);const v=s[process.argv[2]];console.log(Array.isArray(v)?v.join("\n"):v)' "$scope" "$1"; }
  # No mapfile: macOS ships bash 3.2.
  lines() { local l; eval "$1=()"; while IFS= read -r l; do [ -z "$l" ] || eval "$1+=(\"\$l\")"; done < <(field "$2"); }
  lines lint_files lint; lines format_files format; lines test_files tests
  run_full=$(field full)
  step "scope"; printf '%s changed files: %s\n' "$(field changed)" "$(field reason)"
  [ "$run_full" = true ] || printf '%s test files, %s to lint, %s to format\n' "${#test_files[@]}" "${#lint_files[@]}" "${#format_files[@]}"
fi

if has static; then
  step "migrations"; node scripts/gen-migrations-index.mjs && node scripts/gen-migrations-index.mjs --check
  step "terms";     npx tsx scripts/hooks/banned-terms.ts --tree
  if [ "$parallel" = 1 ]; then
    out=$(mktemp -d); trap 'rm -rf "$out"' EXIT
    pids=()
    tsc >"$out/typecheck" 2>&1 & pids+=($!)
    npx eslint . --max-warnings=28 --concurrency=auto >"$out/lint" 2>&1 & pids+=($!)
    npx prettier --check . --log-level warn >"$out/format" 2>&1 & pids+=($!)
    failed=()
    names=(typecheck lint format)
    for i in 0 1 2; do
      wait "${pids[$i]}" || failed+=("${names[$i]}")
      step "${names[$i]}"; cat "$out/${names[$i]}"
    done
    if [ ${#failed[@]} -gt 0 ]; then
      printf '\n✗ failed: %s\n' "${failed[*]}" >&2
      exit 1
    fi
  elif [ "$changed" = 1 ]; then
    step "typecheck"; tsc
    step "lint"
    [ ${#lint_files[@]} -eq 0 ] || npx eslint --max-warnings=28 --no-warn-ignored "${lint_files[@]}"
    step "format"
    [ ${#format_files[@]} -eq 0 ] || npx prettier --check --ignore-unknown --log-level warn "${format_files[@]}"
  else
    step "typecheck"; tsc
    step "lint";      npx eslint . --max-warnings=28 --concurrency=auto
    step "format";    npx prettier --check . --log-level warn
  fi
fi
if has test; then
  if [ "$changed" = 1 ] && [ "$run_full" != true ]; then
    if [ ${#test_files[@]} -gt 0 ]; then
      step "test (related)"; scripts/test "${test_files[@]}" ${vitest_args[@]+"${vitest_args[@]}"}
    else
      step "test"; echo "no test file is related to the changed files"
    fi
  else
    step "test";      scripts/test ${vitest_args[@]+"${vitest_args[@]}"}
  fi
fi
if has build; then
  # The build imports the generated migrations index, so it needs it even
  # when the static group (which checks it) did not run.
  step "migrations"; node scripts/gen-migrations-index.mjs
  step "build";   npx next build
  step "bundle";  node scripts/check-bundle.mjs
fi
printf '\n✓ check passed\n'
