#!/usr/bin/env bash
# Run every minute by serviceman on Saad's Mac: when origin/main moves,
# redeploy the live instance and publish the same commit to npm. Runs in the
# background. Chat turns (tasks' and orchestrators') live in workers and
# outlive the restart, and an orchestrator's tool calls wait for the server to
# return. Reviews and task setups are server jobs that run again after a
# restart, so it waits up to 10 minutes for them rather than pay twice.
#   sm add agentos-autodeploy "scripts/autodeploy" --cron "* * * * *"
# Restarts are spaced AGENTOS_MIN_GAP seconds apart (an hour; 0 turns it
# off): a head that lands inside the gap waits and is deployed, whatever it
# has become by then, when the gap ends. A commit message with [deploy-now]
# (in any commit the deploy would take) skips the gap. Each hold logs one line:
#   HELD <sha> <seconds> left in the restart gap (since <last restart sha>)
# Another machine (a server) runs it with AGENTOS_PUBLISH=0: deploy
# only, and its own AGENTOS_RESTART. Only one machine publishes to npm.
# The machine that publishes also writes the What's New entries for what
# merged (scripts/whats-new, before the publish, so the package carries them)
# and pushes them as a commit that touches only content/whats-new.json. Such a
# commit is pulled but never rebuilt or restarted for, and the generator
# ignores it, so it can't loop. AGENTOS_WHATS_NEW=0 turns the step off.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.nvm/nvm.sh" >/dev/null
  nvm use >/dev/null
fi

state="$HOME/.agent-os/autodeploy"
mkdir -p "$state"
# A lock older than 30 minutes is from a run that died.
for lock in lock publish.lock; do
  if [ -d "$state/$lock" ] && [ -n "$(find "$state/$lock" -maxdepth 0 -mmin +30)" ]; then
    rmdir "$state/$lock"
  fi
done
# One deploy at a time; a deploy can outlast the minute.
mkdir "$state/lock" 2>/dev/null || exit 0
trap 'rmdir "$state/lock"' EXIT

git fetch -q origin main
head=$(git rev-parse origin/main)
deployed=$(cat "$state/deployed" 2>/dev/null || true)
published=$(cat "$state/published" 2>/dev/null || true)
[ "${AGENTOS_PUBLISH:-1}" = 0 ] && published=$head
[ "$head" = "$deployed" ] && [ "$head" = "$published" ] && exit 0
log() { echo "$(date '+%Y-%m-%d %-I:%M %p') $*"; }

# A head that differs from the deployed one only in the changelog file needs
# a pull, not a build or a restart: the file is read from disk when asked.
changelog=content/whats-new.json
if [ "$head" != "$deployed" ] && [ -n "$deployed" ] &&
  [ "$(git diff --name-only "$deployed" "$head" 2>/dev/null)" = "$changelog" ] &&
  [ -z "$(git status --porcelain --untracked-files=no)" ] &&
  git merge -q --ff-only "$head" 2>/dev/null; then
  deployed=$head
  git rev-parse HEAD > "$state/deployed"
  [ "$head" = "$published" ] && exit 0
fi

# Merges land in bursts: one that's under AGENTOS_SETTLE seconds old (2
# minutes) waits for the next run, so a burst is one build and one restart.
# Its commit time is the merge's, so this never holds a deploy forever.
settle="${AGENTOS_SETTLE:-120}"
if [ "$head" != "$deployed" ] && [ "$settle" -gt 0 ] &&
  [ $(( $(date +%s) - $(git log -1 --format=%ct "$head") )) -lt "$settle" ]; then
  exit 0
fi

# Restarts kill simulator starts and reviews in flight, so they are spaced
# apart. The head isn't recorded as deployed while it waits, so it (or a
# newer one) goes out as soon as the gap is over; nothing is dropped.
gap="${AGENTOS_MIN_GAP:-3600}"
if [ "$head" != "$deployed" ] && [ "$gap" -gt 0 ]; then
  last=$(cat "$state/restarted" 2>/dev/null || echo 0)
  left=$(( last + gap - $(date +%s) ))
  if [ "$left" -gt 0 ]; then
    msgs=$(git log --format=%B "${deployed:+$deployed..}$head" 2>/dev/null || git log -1 --format=%B "$head")
    if printf '%s' "$msgs" | grep -qF '[deploy-now]'; then
      log "Restart gap skipped for ${head:0:7}: [deploy-now]"
    else
      # Once per head, not once per minute, so the log counts holds.
      if [ "$(cat "$state/held" 2>/dev/null)" != "$head" ]; then
        echo "$head" > "$state/held"
        log "HELD ${head:0:7} ${left}s left in the ${gap}s restart gap"
      fi
      exit 0
    fi
  fi
fi

# A deploy that can't land says so once per commit, rather than retrying
# quietly every minute (uncommitted edits in this checkout block the pull).
alert() {
  [ "$(cat "$state/alerted" 2>/dev/null)" = "$head" ] && return
  echo "$head" > "$state/alerted"
  log "DEPLOY BLOCKED ${head:0:7}: $1"
  osascript -e "display notification \"$1\" with title \"AgentOS deploy blocked\"" 2>/dev/null || true
  [ -x bin/aos ] && bin/aos notify "AgentOS deploy blocked (${head:0:7}): $1" >/dev/null 2>&1 || true
}

if [ "$head" != "$deployed" ]; then
  dirty=$(git status --porcelain --untracked-files=no | awk '{print $2}' | tr '\n' ' ')
  if [ -n "$dirty" ]; then
    alert "uncommitted changes in $(pwd): $dirty"
    exit 1
  fi
  log "Deploying ${head:0:7}"
  # Before the pull: the build is swapped in under the running server, so
  # the restart follows it closely.
  AGENTOS_QUIET_WAIT="${AGENTOS_QUIET_WAIT:-600}" scripts/wait-quiet
  if ! AGENTOS_RESTART="${AGENTOS_RESTART:-sm restart agentos}" scripts/redeploy; then
    alert "redeploy of ${head:0:7} failed; see sm logs agentos-autodeploy"
    exit 1
  fi
  # The pull takes what landed while it waited, too.
  git rev-parse HEAD > "$state/deployed"
  date +%s > "$state/restarted"
  # A link into an older clone would run an old aos on this machine.
  scripts/sync-cli-links || log "CLI link sync failed"
fi

# The changelog is written before the publish, from the same checkout, so the
# package carries it. Best effort: a failure here never holds up the publish.
if [ "${AGENTOS_PUBLISH:-1}" != 0 ] && [ "${AGENTOS_WHATS_NEW:-1}" != 0 ] &&
  [ "$head" != "$published" ] && [ "$head" = "$(git rev-parse HEAD)" ]; then
  if ! node --import tsx scripts/whats-new.ts --commit \
    --through-file "$state/whats-new-through" >> "$state/whats-new.log" 2>&1; then
    log "What's New step failed; see $state/whats-new.log"
  fi
  head=$(git rev-parse HEAD)
fi

# Publishing waits minutes for npm to serve a version, so it runs on its own
# with its own lock and never holds up the next deploy.
if [ "$head" != "$published" ] && mkdir "$state/publish.lock" 2>/dev/null; then
  (
    trap 'rmdir "$state/publish.lock"; rm -rf "$tmp"' EXIT
    tmp=$(mktemp -d)
    git archive "$head" | tar -x -C "$tmp"
    base=$(node -p 'require("./package.json").version.split(".").slice(0,2).join(".")')
    version="$base.$(git rev-list --count "$head")"
    (cd "$tmp" && npm version "$version" --no-git-tag-version --allow-same-version >/dev/null)
    log "Publishing $version"
    "$tmp/scripts/publish" && echo "$head" > "$state/published"
  ) &
  disown
fi
