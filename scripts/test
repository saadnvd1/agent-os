#!/usr/bin/env bash
# The full suite, kindly: through `aos heavy` (a slot, and other sessions are
# told; skipped inside a check that holds one) and at low priority on a Mac. CI and machines without aos run plain vitest.
set -euo pipefail
cd "$(dirname "$0")/.."
cmd=(npx vitest run "$@")
[ "$(uname)" = Darwin ] && [ -z "${CI:-}" ] && cmd=(nice -n 10 "${cmd[@]}")
if [ -z "${CI:-}" ] && [ -z "${AOS_HEAVY_HELD:-}" ] && command -v aos >/dev/null 2>&1; then
  exec aos heavy -- "${cmd[@]}"
fi
exec "${cmd[@]}"
