#!/usr/bin/env bash
# Update a running checkout to origin's branch: pull, install, build beside
# the live server, swap the build in and restart, so neither a build in
# progress nor a failed one takes the running server down.
# Without AGENTOS_RESTART it builds and checks but swaps nothing in.
# Restart with: AGENTOS_RESTART="<command>" scripts/redeploy
# Put the previous build back: AGENTOS_RESTART="<command>" scripts/redeploy --rollback
# ...and the source with it: scripts/redeploy --rollback --to <sha>
# AGENTOS_UPDATE_TO=<sha> fast-forwards to that commit instead of the head.
# "::stage <name>" lines say how far it got, for scripts/update-recover.mjs.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=lib/build-swap.sh
source scripts/lib/build-swap.sh
# shellcheck source=lib/pnpm.sh
source scripts/lib/pnpm.sh
# shellcheck source=lib/deps-swap.sh
source scripts/lib/deps-swap.sh

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.nvm/nvm.sh" >/dev/null
  nvm use >/dev/null
fi

# A build next to the live one, plus a staged install, needs room; running
# out halfway is the one failure that can leave the disk too full to recover.
check_disk() {
  local need_gb="${AGENTOS_UPDATE_MIN_FREE_GB:-3}" free_kb
  [ "$need_gb" = 0 ] && return 0
  free_kb=$(df -Pk . | awk 'NR==2 {print $4}')
  if [ -n "$free_kb" ] && [ "$free_kb" -lt $((need_gb * 1024 * 1024)) ]; then
    echo "Not enough free disk space: $((free_kb / 1024)) MB free, the update needs ${need_gb} GB." >&2
    exit 1
  fi
}

# The pull can replace this script, so what follows runs from a fresh start.
if [ "${1:-}" != "--rollback" ] && [ "${1:-}" != "--pulled" ]; then
  check_disk
  echo "::phase pulling"
  if [ -n "${AGENTOS_UPDATE_TO:-}" ]; then
    git fetch -q origin
    git merge -q --ff-only "$AGENTOS_UPDATE_TO"
  else
    git pull --ff-only
  fi
  echo "::stage pulled"
  exec bash "$0" --pulled
fi

acquire_build_lock

if [ "${1:-}" = "--rollback" ]; then
  rollback_build
  # The build and the dependencies it ran on go back together.
  restore_deps
  # server.ts and lib/ run from source, so the source goes back too, or the
  # old build would run under the new server code.
  if [ "${2:-}" = "--to" ] && [ -n "${3:-}" ]; then
    git reset -q --keep "$3"
  fi
  echo "::stage build_swapped"
else
  echo "::phase installing"
  use_pnpm
  # The build needs dev dependencies even when the shell runs with
  # NODE_ENV=production (as sessions started by AgentOS do).
  unset NODE_ENV npm_config_production npm_config_omit
  # Installed beside the live node_modules and checked (SQLite opens, a pty
  # spawns) before they replace it: a broken install fails the deploy here,
  # and the running server keeps the build and dependencies it has.
  swapped=0
  install_beside && rc=0 || rc=$?
  [ "$rc" = 0 ] && { swap_deps; swapped=1; echo "::stage deps_swapped"; }
  [ "$rc" = 0 ] || [ "$rc" = 10 ] || exit 1
  install_pdf_browser
  echo "::phase building"
  # A build that fails on the new dependencies puts the old ones back.
  build_beside || { [ "$swapped" = 1 ] && restore_deps; exit 1; }
  if [ -z "${AGENTOS_RESTART:-}" ]; then
    # Nothing can restart the server, and a new build or node_modules under
    # the old process breaks its pages: leave the live tree as it was.
    [ "$swapped" = 1 ] && restore_deps
    echo "Built and verified in $NEXT_BUILD, but not swapped in: nothing here can restart the server."
    echo "Set AGENTOS_RESTART to its restart command and run scripts/redeploy again to swap and restart."
    exit 0
  fi
  swap_build
  echo "::stage build_swapped"
fi

if [ -n "${AGENTOS_RESTART:-}" ]; then
  echo "::phase restarting"
  eval "$AGENTOS_RESTART"
  port="${PORT:-3011}"
  # Startup runs migrations, and one that copies the database first took 4.5
  # minutes on a loaded Mac; a 40s wait called that a failure while it worked.
  for _ in $(seq 1 "${AGENTOS_UP_WAIT:-600}"); do
    if [ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/")" = 200 ]; then
      echo "AgentOS is up on $port"
      exit 0
    fi
    sleep 1
  done
  echo "AgentOS did not come back on $port within ${AGENTOS_UP_WAIT:-600}s; scripts/redeploy --rollback puts the last build back" >&2
  exit 1
fi
echo "Rolled back. Restart your AgentOS server to run it."
