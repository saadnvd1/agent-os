#!/usr/bin/env bash
# Update a running checkout to origin's branch: pull, install, build beside
# the live server, swap the build in and restart, so neither a build in
# progress nor a failed one takes the running server down.
# Restart with: AGENTOS_RESTART="<command>" scripts/redeploy
# Put the previous build back: AGENTOS_RESTART="<command>" scripts/redeploy --rollback
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=lib/build-swap.sh
source scripts/lib/build-swap.sh

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.nvm/nvm.sh" >/dev/null
  nvm use >/dev/null
fi

# One build at a time: two would share .next-build. A lock older than 30
# minutes is from a run that died.
lock=.next-build.lock
if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +30)" ]; then
  rmdir "$lock"
fi
mkdir "$lock" 2>/dev/null || { echo "Another redeploy is building ($lock)" >&2; exit 1; }
trap 'rmdir "$lock"' EXIT

if [ "${1:-}" = "--rollback" ]; then
  rollback_build
else
  git pull --ff-only
  # The build needs dev dependencies even when the shell runs with
  # NODE_ENV=production (as sessions started by AgentOS do).
  npm install --include=dev --no-audit --no-fund
  node scripts/ensure-native.mjs
  build_beside
  swap_build
fi

if [ -n "${AGENTOS_RESTART:-}" ]; then
  eval "$AGENTOS_RESTART"
  port="${PORT:-3011}"
  for _ in $(seq 1 40); do
    if [ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/")" = 200 ]; then
      echo "AgentOS is up on $port"
      exit 0
    fi
    sleep 1
  done
  echo "AgentOS did not come back on $port; scripts/redeploy --rollback puts the last build back" >&2
  exit 1
fi
echo "Built. Restart your AgentOS server to run it."
