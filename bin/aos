#!/usr/bin/env node
// aos: talk to other agent sessions through AgentOS.
// Sessions started by AgentOS have AGENTOS_SESSION_ID and AGENTOS_URL set.

const url = process.env.AGENTOS_URL || "http://127.0.0.1:3011";
const me = process.env.AGENTOS_SESSION_ID || null;
const [cmd, ...args] = process.argv.slice(2);

const usage = `aos: talk to other agent sessions in AgentOS

  aos peers                          sessions, their project and what each is doing
  aos send <session> <message...>    message a session (name, old name, project/name,
                                     id or id prefix); says delivered, queued or
                                     FAILED (exit 2: it waits in their inbox)
  aos inbox                          read messages sent to you
  aos history <session>              your conversation with a session
  aos spawn <project> <prompt...>    start a new agent session in a project
  aos task <project> <prompt...>     start a background task that ends in a PR
                                     (--on <machine>: on a linked machine's AgentOS)
                                     (--name "<name>": name it; otherwise it's
                                     named from the prompt)
  aos stack <project> [--plan] [--max N]
                                     run the project's linked board as stacked tasks
                                     (--plan: just show the order, start nothing)
  aos stacks                         every stack and where each card is
  aos schedules                      every schedule, its next run and last outcome
  aos schedule run <name>            run a schedule now (name or id)
  aos schedule add --session <session> --every 30m [--name N] <prompt...>
                                     message a session on a timer (at most every
                                     10 minutes); skips while it's still working
  aos notify <text...>               push a message to the owner's phone (or text
                                     on stdin); at most one a minute, the rest
                                     wait and go together
  aos done <session>                 finished: merge its open PR through the
                                     gates, stop it, archive it (not a rejection);
                                     only sessions in your workspace or project
  aos done --all-idle                clean up every idle or stopped session there;
                                     never merges, lists open PRs instead

  Docs, when your project's workspace is linked to LumifyHub:
  aos docs [query]                   list the workspace's pages (id, title)
  aos doc <id>                       print a page's markdown
  aos doc new "<title>" [--file f]   create a page from a file or stdin; prints its URL`;

// Needed only when AgentOS is reached over a network that requires pairing.
const token = process.env.AGENTOS_TOKEN;

async function call(path, init = {}) {
  let res;
  try {
    const headers = {
      ...init.headers,
      ...(token && { Authorization: `Bearer ${token}` }),
    };
    res = await fetch(url + path, { ...init, headers });
  } catch {
    fail(`can't reach AgentOS at ${url}`);
  }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) fail(data.error || `request failed (${res.status})`);
  return data;
}

const post = (path, body) =>
  call(path, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });

function fail(msg) {
  console.error(`aos: ${msg}`);
  process.exit(1);
}

function needMe() {
  if (!me) fail("not inside an AgentOS session (AGENTOS_SESSION_ID is unset)");
}

async function stdin() {
  if (process.stdin.isTTY) return "";
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}

// `[--name "x"] <project> [--name "x"] <prompt...>`: the flag counts only
// before the prompt starts, so a prompt may mention --name.
function parseSpawnArgs(words) {
  let name;
  let on;
  let project;
  let i = 0;
  for (; i < words.length; i++) {
    const w = words[i];
    if (w === "--name") {
      name = words[++i];
      if (name === undefined) fail("--name needs a value");
    } else if (w.startsWith("--name=")) name = w.slice(7);
    else if (w === "--on") {
      on = words[++i];
      if (on === undefined) fail("--on needs a machine");
    } else if (w.startsWith("--on=")) on = w.slice(5);
    else if (project === undefined) project = w;
    else break;
  }
  return {
    name: name?.trim() || undefined,
    on: on?.trim() || undefined,
    project,
    prompt: words.slice(i),
  };
}

// `doc new "<title>" [--file path]`: the title is every word but the flag.
function parseDocNew(words) {
  const at = words.findIndex((w) => w === "--file" || w === "-f");
  const file = at >= 0 ? words[at + 1] : null;
  if (at >= 0 && !file) fail("--file needs a path");
  const title = words.filter((_, i) => at < 0 || (i !== at && i !== at + 1));
  return { title: title.join(" ").trim(), file };
}

async function docNew(words) {
  const { title, file } = parseDocNew(words);
  if (!title) fail('usage: aos doc new "<title>" [--file path]');
  let content;
  try {
    content = file ? require("fs").readFileSync(file, "utf8") : await stdin();
  } catch (error) {
    fail(`can't read ${file}: ${error.message}`);
  }
  const { page } = await post("/api/bus/docs", { session: me, title, content });
  console.log(page.url);
}

// One line per card, indented under the card it is stacked on.
function stackLines(items) {
  const ids = new Set(items.map((i) => i.id));
  const tree = [];
  const walk = (parent) =>
    items
      .filter(
        (i) =>
          (i.parentId && ids.has(i.parentId) ? i.parentId : null) === parent
      )
      .forEach((i) => {
        tree.push(i);
        walk(i.id);
      });
  walk(null);
  return tree.map((i) => {
    const pr = i.prUrl ? `  ${i.prUrl}` : "";
    const why = i.error || i.waitsOn || i.note;
    const also = i.also.length ? `  (also waits on ${i.also.join(", ")})` : "";
    const name = i.ticket ? `${i.ticket} ${i.title}` : i.title;
    return `${"  ".repeat(i.depth + 1)}${i.status.padEnd(8)} ${name}${pr}${also}${why ? `\n${"  ".repeat(i.depth + 6)}${why}` : ""}`;
  });
}

function parseStackArgs(words) {
  const plan = words.includes("--plan");
  const at = words.indexOf("--max");
  const max = at >= 0 ? Number(words[at + 1]) : undefined;
  if (at >= 0 && !(max >= 1)) fail("--max needs a number");
  const project = words
    .filter((w, i) => w !== "--plan" && (at < 0 || (i !== at && i !== at + 1)))
    .join(" ");
  if (!project) fail("usage: aos stack <project> [--plan] [--max N]");
  return { project, plan, max };
}

const show = (m) =>
  `${m.createdAt}  ${m.fromName} → ${m.toName}\n  ${m.body.replace(/\n/g, "\n  ")}`;

// `schedule add --session <ref> --every 30m [--name N] [--cron "..."] <prompt>`
async function scheduleAdd(words) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < words.length; i++) {
    const m = /^--(session|every|name|cron|tz)$/.exec(words[i]);
    if (m) {
      if (words[i + 1] === undefined) fail(`--${m[1]} needs a value`);
      flags[m[1]] = words[++i];
    } else rest.push(words[i]);
  }
  const prompt = rest.join(" ").trim();
  if (!flags.session || !prompt)
    fail(
      'usage: aos schedule add --session <id|name> --every 30m [--name N] "<prompt>"'
    );
  const { schedule } = await post("/api/schedules", {
    from: me,
    session: flags.session,
    every: flags.every,
    cron: flags.cron,
    name: flags.name,
    timezone: flags.tz,
    prompt,
  });
  console.log(
    `${schedule.id.slice(0, 8)}  ${schedule.name} · messages ${schedule.targetName ?? schedule.target_session_id} · ${schedule.description}`
  );
}

async function main() {
  switch (cmd) {
    case "peers": {
      const { peers } = await call("/api/bus/peers");
      for (const p of peers) {
        if (p.id === me) continue;
        const where = p.projectName ? `${p.projectName}/` : "";
        const state = p.running ? p.doing || "running" : "not running";
        const was = p.was.length ? ` (was ${p.was.join(", ")})` : "";
        console.log(
          `${p.id.slice(0, 8)}  ${where}${p.name}${was}  ·  ${state}`
        );
      }
      return;
    }
    case "send": {
      needMe();
      const [to, ...words] = args;
      if (!to || !words.length) fail("usage: aos send <session> <message...>");
      const { message, delivery, note } = await post("/api/bus/send", {
        from: me,
        to,
        body: words.join(" "),
      });
      if (note) console.log(`note: ${note}`);
      if (delivery.state === "failed") {
        console.error(
          `FAILED: ${delivery.why}. It is saved in ${message.toName}'s inbox (aos inbox).`
        );
        process.exit(2);
      }
      console.log(
        delivery.state === "queued"
          ? `queued for ${message.toName}: it's busy and will see it after this turn`
          : `delivered to ${message.toName}`
      );
      return;
    }
    case "inbox": {
      needMe();
      const { messages } = await call(
        `/api/bus/inbox?session=${encodeURIComponent(me)}`
      );
      console.log(
        messages.length ? messages.map(show).join("\n\n") : "no new messages"
      );
      return;
    }
    case "history": {
      needMe();
      const [other] = args;
      if (!other) fail("usage: aos history <session>");
      const { peer } = await call(
        `/api/bus/peers?ref=${encodeURIComponent(other)}`
      );
      const { messages } = await call(
        `/api/bus/messages?session=${encodeURIComponent(me)}`
      );
      const thread = messages.filter(
        (m) => m.fromId === peer.id || m.toId === peer.id
      );
      console.log(
        thread.length ? thread.map(show).join("\n\n") : "no messages yet"
      );
      return;
    }
    case "spawn":
    case "task": {
      const { name, on, project, prompt: words } = parseSpawnArgs(args);
      if (!project || !words.length)
        fail(
          `usage: aos ${cmd} <project> [--name "<name>"]${cmd === "task" ? " [--on <machine>]" : ""} <prompt...>`
        );
      if (on && cmd !== "task") fail("--on works for tasks only");
      const { session } = await post("/api/bus/spawn", {
        project,
        prompt: words.join(" "),
        mode: cmd === "task" ? "task" : "session",
        ...(name && { name }),
        ...(on && { on }),
      });
      console.log(
        `started ${cmd === "task" ? "task" : "session"} "${session.name}"`
      );
      return;
    }
    case "stack": {
      const { project, plan, max } = parseStackArgs(args);
      const res = await post("/api/stacks", {
        project,
        dryRun: plan,
        maxParallel: max,
      });
      const view = res.preview || res.stack;
      const title = res.preview
        ? `plan for ${view.boardName || view.projectName} (nothing started)`
        : `started stack "${view.name}" (${view.maxParallel} at a time)`;
      console.log([title, ...stackLines(view.items)].join("\n"));
      return;
    }
    case "stacks": {
      const { stacks } = await call("/api/stacks");
      if (!stacks.length) console.log("no stacks");
      for (const s of stacks) {
        const head = `${s.name} · ${s.projectName} · ${s.status}`;
        const extra = [s.progress, s.error].filter(Boolean).join("\n  ");
        console.log(
          [head + (extra ? `\n  ${extra}` : ""), ...stackLines(s.items)].join(
            "\n"
          )
        );
      }
      return;
    }
    case "schedules": {
      const { schedules } = await call("/api/schedules");
      if (!schedules.length) console.log("no schedules");
      const when = (ms, tz) =>
        new Date(ms).toLocaleString("en-US", {
          timeZone: tz,
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      for (const s of schedules) {
        const state = !s.enabled ? "off" : s.paused ? "paused" : "on";
        const next =
          s.enabled && s.nextRunAt ? when(s.nextRunAt, s.timezone) : "-";
        const last = s.lastRun
          ? `${s.lastRun.outcome}${s.lastRun.detail ? ` (${s.lastRun.detail})` : ""}`
          : "never run";
        const target = s.targetName
          ? ` → ${s.targetName}`
          : s.projectName
            ? ` · ${s.projectName}`
            : "";
        console.log(
          `${s.id.slice(0, 8)}  ${s.name} · ${s.kind}${target} · ${state}\n  ${s.description} · next ${next} · last ${last}`
        );
      }
      return;
    }
    case "schedule": {
      const [sub, ...words] = args;
      if (sub === "add") return scheduleAdd(words);
      const ref = words.join(" ").trim();
      if (sub !== "run" || !ref)
        fail(
          "usage: aos schedule run <name> | aos schedule add --session <session> --every 30m <prompt>"
        );
      const { run, schedule } = await post(
        `/api/schedules/${encodeURIComponent(ref)}/run`,
        {}
      );
      const why = run.detail ? `: ${run.detail}` : "";
      console.log(`${schedule.name}: ${run.outcome}${why}`);
      if (run.outcome === "failed") process.exit(2);
      return;
    }
    case "notify": {
      const text = (args.join(" ") || (await stdin())).trim();
      if (!text) fail('usage: aos notify "<text>" (or text on stdin)');
      const res = await post("/api/notify", { from: me, text });
      if (res.state === "sent") console.log("sent");
      else if (res.state === "duplicate")
        console.log("already sent this in the last minute; not sent again");
      else if (res.state === "dropped")
        console.log("dropped: too many already waiting from you this minute");
      else if (res.state === "held")
        console.log(
          `held: goes out within ${Math.ceil(res.inMs / 1000)}s with anything else sent meanwhile`
        );
      return;
    }
    case "done": {
      const allIdle = args.includes("--all-idle");
      const session = args.filter((a) => a !== "--all-idle").join(" ");
      if (allIdle === !!session)
        fail("usage: aos done <session> | aos done --all-idle");
      needMe();
      const { summary } = await post("/api/bus/done", {
        from: me,
        session,
        allIdle,
      });
      console.log(summary);
      return;
    }
    case "docs": {
      needMe();
      const q = encodeURIComponent(args.join(" "));
      const { pages } = await call(
        `/api/bus/docs?session=${encodeURIComponent(me)}&q=${q}`
      );
      if (!pages.length) console.log("no pages");
      for (const p of pages) console.log(`${p.id}  ${p.title}`);
      return;
    }
    case "doc": {
      needMe();
      const [id, ...rest] = args;
      if (id === "new") return docNew(rest);
      if (!id)
        fail('usage: aos doc <id> | aos doc new "<title>" [--file path]');
      const { page } = await call(
        `/api/bus/docs/${encodeURIComponent(id)}?session=${encodeURIComponent(me)}`
      );
      console.log(`# ${page.title}\n\n${page.content}`.trimEnd());
      return;
    }
    default:
      console.log(usage);
      process.exit(cmd && cmd !== "help" && cmd !== "--help" ? 1 : 0);
  }
}

main();
